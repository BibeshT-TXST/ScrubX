# Copy to .env.local. Every value is optional; the demo runs with none set.

# The app always uses a real model (Gemini). Without a key it still runs, and every
# chat reply says it couldn't connect. Server-side only; never exposed to the browser.
GEMINI_API_KEY=
# Optional model override (default: gemini-3.8-flash)
LLM_MODEL=
# Model for the last retry when the main one is overloaded (default: gemini-3.5-flash-lite; "none" disables)
LLM_FALLBACK_MODEL=

# demo | supabase
PATIENT_SOURCE=demo
# Required for supabase. URL: dashboard → Connect (or Settings → Data API).
# Key: Settings → API Keys → a secret key (sb_secret_…), or the legacy service_role key.
# Server-side only: never prefix with NEXT_PUBLIC_.
# Setup: run supabase/migrations/0001_patients.sql, then `npm run db:seed`.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Trace snapshots contain PHI. Unset = on for PATIENT_SOURCE=demo (synthetic), off otherwise.
SCRUBX_TRACE_PAYLOADS=

RISK_BLOCK_THRESHOLD=0.8
RISK_FLAG_THRESHOLD=0.4
