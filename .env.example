# Copy to .env.local. Every value is optional; the demo runs with none set.

# mock | openrouter
LLM_PROVIDER=mock
OPENROUTER_API_KEY=
LLM_MODEL=
# Simulated latency of the mock model in ms (makes the streamed trace visible)
MOCK_LATENCY_MS=500

# demo | supabase
PATIENT_SOURCE=demo
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Trace snapshots contain PHI. Only enable for the synthetic demo.
SCRUBX_TRACE_PAYLOADS=true

RISK_BLOCK_THRESHOLD=0.8
RISK_FLAG_THRESHOLD=0.4
